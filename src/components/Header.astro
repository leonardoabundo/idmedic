---
import TopBar from './TopBar.astro';
import { productCatalog } from '../data/productCatalog';

const productMegaItems = productCatalog.map((category) => ({
  id: category.slug,
  label: category.label,
  href: category.href,
  secondary: category.subcategories.map((subcategory) => ({
    label: subcategory.label,
    href: `/productos/${category.slug}/${subcategory.slug}`,
  })),
  promo: category.promo,
}));

const navLinks = [
  { label: '\u00c1reas de atenci\u00f3n', href: '/#areas' },
  {
    label: 'Productos',
    href: productMegaItems[0]?.href ?? '/#productos',
    children: productMegaItems.map((item) => ({ label: item.label, href: item.href })),
    megaMenu: {
      items: productMegaItems,
    },
  },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Nosotros', href: '/nosotros' },
];
---

<div class="header-wrapper" id="header-wrapper">
  <TopBar />
  <header class="header" id="main-header">
    <div class="header__inner container">
      <a href="/" class="header__logo" aria-label="IDMedic - Inicio">
        <img src="/images/idmedic-logo-png.webp" alt="IDMedic" class="header__logo-img" />
      </a>

      <nav class="header__nav" aria-label="Navegaci\u00f3n principal">
        <ul class="header__nav-list">
          {navLinks.map((link) => (
            <li class:list={['header__nav-item', { 'header__nav-item--has-children': !!link.children }]}>
              <a href={link.href} class="header__nav-link">
                <span>{link.label}</span>
                {link.children && (
                  <svg class="header__nav-caret" viewBox="0 0 12 12" aria-hidden="true">
                    <path d="M3 4.5 6 7.5l3-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
              </a>
              {link.children && !link.megaMenu && (
                <div class="header__dropdown" aria-label={`Submenu de ${link.label}`}>
                  <ul class="header__dropdown-list">
                    {link.children.map((child) => (
                      <li>
                        <a href={child.href} class="header__dropdown-link">{child.label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {link.megaMenu && (
                <div class="header__mega-menu" aria-label={`Submenu de ${link.label}`} data-active-panel={link.megaMenu.items[0].id}>
                  <div class="header__mega-column">
                    <ul class="header__mega-list">
                      {link.megaMenu.items.map((item, index) => (
                        <li>
                          <button
                            type="button"
                            class:list={['header__mega-trigger', { 'is-active': index === 0 }]}
                            data-panel-trigger={item.id}
                            aria-pressed={index === 0 ? 'true' : 'false'}
                          >
                            <span>{item.label}</span>
                            <svg class="header__mega-arrow" viewBox="0 0 16 16" aria-hidden="true">
                              <path d="M3.5 8h9M9.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                          </button>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div class="header__mega-column header__mega-column--secondary">
                    {link.megaMenu.items.map((item, index) => (
                      <div class:list={['header__mega-panel', { 'is-active': index === 0 }]} data-panel={item.id}>
                        <ul class="header__mega-list header__mega-list--secondary">
                          {item.secondary.map((secondaryItem) => (
                            <li>
                              <a href={secondaryItem.href} class="header__mega-link header__mega-link--secondary">{secondaryItem.label}</a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>

                  <div class="header__mega-promo">
                    {link.megaMenu.items.map((item, index) => (
                      <a
                        href={item.promo.href}
                        class:list={['header__mega-promo-card', { 'is-active': index === 0 }]}
                        data-promo-panel={item.id}
                      >
                        <img src={item.promo.image} alt={item.label} class="header__mega-promo-image" />
                        <span class="header__mega-promo-cta">
                          {item.promo.label}
                          <svg viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M3.5 8h9M9.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <div class="header__actions">
        <a
          href="/login"
          class="header__account"
          aria-label="Iniciar sesión"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6" fill="currentColor" />
          </svg>
        </a>
        <a href="/contacto" class="btn btn-primary btn-sm">Contacto</a>
        <a href="/#soporte" class="btn btn-outline btn-sm">Soporte</a>
      </div>

      <button
        class="header__hamburger"
        id="menu-toggle"
        aria-label="Abrir men\u00fa"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="header__hamburger-line"></span>
        <span class="header__hamburger-line"></span>
        <span class="header__hamburger-line"></span>
      </button>
    </div>

    <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
      <div class="mobile-menu__overlay" id="mobile-overlay"></div>
      <div class="mobile-menu__panel">
        <div class="mobile-menu__header">
          <a href="/" class="header__logo" aria-label="IDMedic - Inicio">
            <img src="/images/idmedic-logo-png.webp" alt="IDMedic" class="header__logo-img" />
          </a>
          <button class="mobile-menu__close" id="menu-close" aria-label="Cerrar men\u00fa">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M18 6L6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
        <nav class="mobile-menu__nav" aria-label="Navegaci\u00f3n m\u00f3vil">
          <ul class="mobile-menu__list">
            {navLinks.map((link) => (
              <li class="mobile-menu__item">
                <a href={link.href} class="mobile-menu__link">{link.label}</a>
                {link.children && (
                  <ul class="mobile-menu__sublist">
                    {link.children.map((child) => (
                      <li>
                        <a href={child.href} class="mobile-menu__sublink">{child.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
          <div class="mobile-menu__actions">
            <a href="/contacto" class="btn btn-primary btn-lg" style="width:100%">Contacto</a>
            <a href="/#soporte" class="btn btn-outline btn-lg" style="width:100%">Soporte</a>
          </div>
        </nav>
      </div>
    </div>
  </header>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const close = document.getElementById('menu-close');
  const menu = document.getElementById('mobile-menu');
  const overlay = document.getElementById('mobile-overlay');
  const body = document.body;

  function openMenu() {
    menu?.setAttribute('aria-hidden', 'false');
    menu?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
    body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu?.setAttribute('aria-hidden', 'true');
    menu?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
    body.style.overflow = '';
  }

  toggle?.addEventListener('click', openMenu);
  close?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  menu?.querySelectorAll('.mobile-menu__link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.querySelectorAll('.header__mega-menu').forEach((megaMenu) => {
    const triggers = megaMenu.querySelectorAll('[data-panel-trigger]');
    const panels = megaMenu.querySelectorAll('[data-panel]');
    const promoPanels = megaMenu.querySelectorAll('[data-promo-panel]');

    function setActivePanel(panelId) {
      megaMenu.setAttribute('data-active-panel', panelId);

      triggers.forEach((trigger) => {
        const isActive = trigger.getAttribute('data-panel-trigger') === panelId;
        trigger.classList.toggle('is-active', isActive);
        trigger.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      panels.forEach((panel) => {
        panel.classList.toggle('is-active', panel.getAttribute('data-panel') === panelId);
      });

      promoPanels.forEach((panel) => {
        panel.classList.toggle('is-active', panel.getAttribute('data-promo-panel') === panelId);
      });
    }

    triggers.forEach((trigger) => {
      const panelId = trigger.getAttribute('data-panel-trigger');
      if (!panelId) return;

      trigger.addEventListener('click', () => setActivePanel(panelId));
      trigger.addEventListener('mouseenter', () => setActivePanel(panelId));
      trigger.addEventListener('focus', () => setActivePanel(panelId));
    });
  });

  const headerWrapper = document.getElementById('header-wrapper');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      headerWrapper?.classList.add('is-scrolled');
    } else {
      headerWrapper?.classList.remove('is-scrolled');
    }
  });
</script>

<style>
  .header-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background-color: var(--bg-white);
    transition:
      box-shadow var(--transition-base),
      transform var(--transition-base);
  }

  .header-wrapper.is-scrolled {
    box-shadow: var(--shadow-md);
    transform: translateY(calc(var(--topbar-height) * -1));
  }

  .header {
    position: relative;
    background-color: var(--bg-white);
    height: var(--header-height);
    border-bottom: 1px solid var(--border-light);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-8);
  }

  .header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    transition: opacity var(--transition-fast);
  }

  .header__logo:hover {
    opacity: 0.8;
  }

  .header__logo-img {
    height: 70px;
    width: auto;
    object-fit: contain;
  }

  .header__nav {
    display: flex;
    align-items: center;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header__nav-item {
    position: relative;
  }

  .header__nav-item--has-children {
    position: static;
  }

  .header__nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: #000000;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    white-space: nowrap;
  }

  .header__nav-link:hover {
    color: var(--primary);
    background-color: var(--primary-light);
  }

  .header__nav-caret {
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .header__account {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: #000000;
    border-radius: var(--radius-full);
    flex-shrink: 0;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .header__account:hover {
    color: var(--primary);
    background-color: var(--primary-light);
  }

  .header__account svg {
    width: 1.4rem;
    height: 1.4rem;
    display: block;
  }

  .header__dropdown {
    position: absolute;
    top: calc(100% + var(--space-3));
    left: 0;
    min-width: 250px;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--bg-white);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      visibility var(--transition-fast);
  }

  .header__mega-menu {
    position: absolute;
    top: calc(100% + 1px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: min(1240px, calc(100vw - 48px));
    display: grid;
    grid-template-columns: 1.05fr 1fr 0.95fr;
    gap: var(--space-8);
    padding: var(--space-8);
    border: 1px solid var(--border);
    border-top: none;
    background-color: var(--bg-white);
    box-shadow: 0 20px 38px rgba(11, 42, 69, 0.12);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      visibility var(--transition-fast);
  }

  .header__mega-column {
    min-width: 0;
  }

  .header__mega-column--secondary,
  .header__mega-promo {
    border-left: 1px solid #d8e0fb;
    padding-left: var(--space-8);
  }

  .header__mega-list {
    display: grid;
    gap: var(--space-3);
  }

  .header__mega-list--secondary {
    gap: var(--space-4);
  }

  .header__mega-trigger,
  .header__mega-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: 1rem;
    color: #000000;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .header__mega-trigger {
    width: 100%;
    padding: var(--space-2) 0;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font: inherit;
  }

  .header__mega-trigger:hover,
  .header__mega-trigger.is-active,
  .header__mega-link:hover {
    color: var(--primary);
  }

  .header__mega-trigger.is-active {
    font-weight: var(--font-weight-bold);
  }

  .header__mega-link--featured {
    font-size: 1.05rem;
    font-weight: var(--font-weight-bold);
  }

  .header__mega-link--secondary {
    line-height: 1.35;
  }

  .header__mega-arrow {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .header__mega-panel,
  .header__mega-promo-card {
    display: none;
  }

  .header__mega-panel.is-active,
  .header__mega-promo-card.is-active {
    display: block;
  }

  .header__mega-promo-card {
    position: relative;
    min-height: 500px;
    border-radius: 28px;
    overflow: hidden;
    background-color: #d6e2ea;
  }

  .header__mega-promo-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.02), rgba(11, 42, 69, 0.12));
  }

  .header__mega-promo-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .header__mega-promo-cta {
    position: absolute;
    left: var(--space-6);
    right: var(--space-6);
    bottom: var(--space-5);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 64px;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-full);
    background-color: rgba(255, 255, 255, 0.96);
    color: var(--text-primary);
    font-size: 1.05rem;
    font-weight: var(--font-weight-semibold);
  }

  .header__mega-promo-cta svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .header__dropdown-list {
    display: grid;
    gap: var(--space-1);
  }

  .header__dropdown-link {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: #000000;
    transition: all var(--transition-fast);
  }

  .header__dropdown-link:hover {
    color: var(--primary);
    background-color: var(--primary-light);
  }

  .header__nav-item--has-children:hover .header__dropdown,
  .header__nav-item--has-children:focus-within .header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__nav-item--has-children:hover .header__mega-menu,
  .header__nav-item--has-children:focus-within .header__mega-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .header__nav-item--has-children:hover .header__nav-caret,
  .header__nav-item--has-children:focus-within .header__nav-caret {
    transform: rotate(180deg);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .header__actions :global(.btn) {
    padding: var(--space-3) var(--space-10);
    font-size: var(--font-size-base);
    border-radius: 18px;
  }

  .header__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast);
  }

  .header__hamburger:hover {
    background-color: var(--bg-light);
  }

  .header__hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 2px;
    transition: all var(--transition-fast);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 1001;
    pointer-events: none;
    visibility: hidden;
  }

  .mobile-menu.is-open {
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-menu__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.4);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .mobile-menu.is-open .mobile-menu__overlay {
    opacity: 1;
  }

  .mobile-menu__panel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(85vw, 380px);
    height: 100%;
    background-color: var(--bg-white);
    transform: translateX(100%);
    transition: transform var(--transition-base);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-lg);
  }

  .mobile-menu.is-open .mobile-menu__panel {
    transform: translateX(0);
  }

  .mobile-menu__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .mobile-menu__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .mobile-menu__close:hover {
    background-color: var(--bg-light);
    color: var(--text-primary);
  }

  .mobile-menu__nav {
    flex: 1;
    padding: var(--space-4) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-menu__item {
    display: grid;
    gap: var(--space-1);
  }

  .mobile-menu__link {
    display: block;
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--text-secondary);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .mobile-menu__link:hover {
    color: var(--primary);
    background-color: var(--primary-light);
  }

  .mobile-menu__sublist {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-4);
  }

  .mobile-menu__sublink {
    display: block;
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-sm);
    color: var(--text-secondary);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .mobile-menu__sublink:hover {
    color: var(--primary);
    background-color: var(--primary-light);
  }

  .mobile-menu__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 1024px) {
    .header__nav,
    .header__actions {
      display: none;
    }

    .header__hamburger {
      display: flex;
    }
  }
</style>
