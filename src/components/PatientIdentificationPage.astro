---
interface Props {
  area: {
    title: string;
    intro: string;
  };
}

const { area } = Astro.props;

const benefits = [
  {
    title: 'Seguridad en la identificacion',
    description:
      'Disminuye errores de registro y mejora la correcta asociacion entre paciente, procedimiento y muestra.',
  },
  {
    title: 'Materiales listos para hospital',
    description:
      'Brazaletes pensados para uso clinico continuo, con buena lectura y resistencia frente a humedad y friccion.',
  },
  {
    title: 'Cobertura para varias edades',
    description:
      'Soluciones adaptadas para pacientes adultos, pediatricos y recien nacidos en un mismo flujo operativo.',
  },
];

const solutions = [
  {
    title: 'Brazaletes termicos adulto/pediatrico',
    description:
      'Formato para identificacion segura en admision, hospitalizacion y seguimiento del paciente.',
    href: '/productos/brazaletes/adulto-pediatrico',
  },
  {
    title: 'Brazaletes termicos recien nacidos',
    description:
      'Diseno orientado a areas neonatales con tamano adecuado y superficie lista para impresion.',
    href: '/areas/identificacion-de-pacientes',
  },
];
---

<section class="patient-id">
  <div class="container">
    <section class="patient-id__hero">
      <div class="patient-id__intro">
        <h1 class="patient-id__title">
          <span class="patient-id__title-line patient-id__title-line--top">
            <span class="patient-id__title-highlight">Identificacion</span>
          </span>
          <span class="patient-id__title-line patient-id__title-line--bottom">para&nbsp;pacientes</span>
        </h1>
        <p class="patient-id__lead">
          Sistema de identificacion para pacientes adulto, pediatrico y recien nacidos.
        </p>
      </div>

      <div class="patient-id__media">
        <div class="patient-id__media-frame">
          <img
            src="/images/brazaletes/etiqueta-brazalete-paciente-clinica.webp"
            alt="Brazalete de identificacion para paciente clinico"
            class="patient-id__media-image"
            loading="eager"
          />
        </div>

        <div class="patient-id__cta">
          <p>Conoce todos nuestros productos</p>
          <a href="/#productos" class="btn btn-primary">Ver productos</a>
        </div>
      </div>

      <div class="patient-id__stats">
        <div class="patient-id__stats-copy">
          <p class="patient-id__stats-text">
            {area.intro}
          </p>

          <div class="patient-id__metrics">
            <div class="patient-id__metric">
              <strong>
                <span class="patient-id__counter" data-target="80" data-decimals="0" data-suffix="%">80%</span>
              </strong>
              <span>Trazabilidad visual</span>
            </div>
            <div class="patient-id__metric">
              <strong>
                <span class="patient-id__counter" data-target="0.5" data-decimals="1" data-suffix="%">0.5%</span>
              </strong>
              <span>Margen de error manual</span>
            </div>
            <div class="patient-id__metric">
              <strong>
                <span class="patient-id__counter" data-target="65" data-decimals="0" data-suffix="%">65%</span>
              </strong>
              <span>Agilidad operativa</span>
            </div>
          </div>
        </div>

        <div class="patient-id__chart">
          <div
            class="patient-id__donut"
            data-chart-target="80"
            data-chart-decimals="0"
            data-chart-suffix="%"
            data-chart-progress="22"
            aria-label="80% de control y seguridad"
          >
            <span class="patient-id__chart-value">80%</span>
          </div>
          <span class="patient-id__chart-label">Control y seguridad</span>
        </div>
      </div>
    </section>
  </div>

  <section class="patient-id__benefits">
    <div class="container">
      <div class="patient-id__benefits-head">
        <h2>Beneficios clave</h2>
        <p>
          Implementa una solucion pensada para reducir errores de identificacion, facilitar la lectura de datos y reforzar la seguridad del paciente en cada etapa del proceso clinico.
        </p>
      </div>

      <div class="patient-id__benefit-grid">
        {benefits.map((benefit) => (
          <article class="patient-id__benefit-card">
            <div class="patient-id__icon" aria-hidden="true">
              <svg viewBox="0 0 80 80" role="presentation">
                <path d="M40 6 64 17v18c0 16-10 28-24 39C26 63 16 51 16 35V17L40 6Z" fill="#0B6FB3" />
                <path d="M40 14 57 22v13c0 12-7 21-17 29-10-8-17-17-17-29V22l17-8Z" fill="#0F8ED8" opacity="0.82" />
                <path d="m31 40 7 7 13-13" fill="none" stroke="#EAF6FD" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <h3>{benefit.title}</h3>
            <p>{benefit.description}</p>
          </article>
        ))}
      </div>

      <div class="patient-id__benefits-ribbon">
        Solucion preparada para admision, hospitalizacion, emergencia y neonatologia.
      </div>
    </div>
  </section>

  <section class="patient-id__solutions">
    <div class="container patient-id__solutions-layout">
      <div class="patient-id__solutions-copy">
        <span>Nuestras</span>
        <h2>Soluciones</h2>
      </div>

      <div class="patient-id__solutions-grid">
        {solutions.map((solution) => (
          <article class="patient-id__solution-card">
            <div class="patient-id__solution-media" aria-label="Espacio reservado para imagen del producto">
              <span>Espacio para imagen</span>
            </div>
            <div class="patient-id__solution-body">
              <h3>{solution.title}</h3>
              <p>{solution.description}</p>
              <a href={solution.href} class="patient-id__solution-link">Mas informacion</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</section>

<script>
  const statsSection = document.querySelector('.patient-id__stats');
  const metricsSection = document.querySelector('.patient-id__metrics');
  const counters = Array.from(document.querySelectorAll('.patient-id__counter'));
  const chart = document.querySelector('.patient-id__donut');
  const chartValue = chart?.querySelector('.patient-id__chart-value');

  function formatCount(value, decimals, suffix) {
    return `${value.toFixed(decimals)}${suffix}`;
  }

  function animateStats() {
    const duration = 1400;
    const start = performance.now();

    const targets = counters.map((counter) => ({
      element: counter,
      target: Number(counter.dataset.target || 0),
      decimals: Number(counter.dataset.decimals || 0),
      suffix: counter.dataset.suffix || '',
    }));

    const chartTarget = Number(chart?.dataset.chartTarget || 0);
    const chartDecimals = Number(chart?.dataset.chartDecimals || 0);
    const chartSuffix = chart?.dataset.chartSuffix || '';
    const chartProgress = Number(chart?.dataset.chartProgress || 0);

    function step(now) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);

      targets.forEach((item) => {
        const current = item.target * eased;
        item.element.textContent = formatCount(current, item.decimals, item.suffix);
      });

      if (chart && chartValue) {
        chart.style.setProperty('--outer-progress', `${chartProgress * eased}%`);
        chartValue.textContent = formatCount(chartTarget * eased, chartDecimals, chartSuffix);
      }

      if (progress < 1) {
        requestAnimationFrame(step);
        return;
      }

      targets.forEach((item) => {
        item.element.textContent = formatCount(item.target, item.decimals, item.suffix);
      });

      if (chart && chartValue) {
        chart.style.setProperty('--outer-progress', `${chartProgress}%`);
        chartValue.textContent = formatCount(chartTarget, chartDecimals, chartSuffix);
      }
    }

    requestAnimationFrame(step);
  }

  if (statsSection && metricsSection && counters.length > 0) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      counters.forEach((counter) => {
        const target = Number(counter.dataset.target || 0);
        const decimals = Number(counter.dataset.decimals || 0);
        const suffix = counter.dataset.suffix || '';
        counter.textContent = formatCount(target, decimals, suffix);
      });

      if (chart && chartValue) {
        chart.style.setProperty('--outer-progress', `${Number(chart.dataset.chartProgress || 0)}%`);
        chartValue.textContent = formatCount(
          Number(chart.dataset.chartTarget || 0),
          Number(chart.dataset.chartDecimals || 0),
          chart.dataset.chartSuffix || ''
        );
      }
    } else {
      counters.forEach((counter) => {
        const decimals = Number(counter.dataset.decimals || 0);
        const suffix = counter.dataset.suffix || '';
        counter.textContent = formatCount(0, decimals, suffix);
      });

      if (chart && chartValue) {
        chart.style.setProperty('--outer-progress', '0%');
        chartValue.textContent = formatCount(
          0,
          Number(chart.dataset.chartDecimals || 0),
          chart.dataset.chartSuffix || ''
        );
      }

      const observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];
          if (!entry?.isIntersecting) return;
          animateStats();
          observer.disconnect();
        },
        { threshold: 0.35 }
      );

      observer.observe(statsSection);
    }
  }
</script>

<style>
  .patient-id {
    padding-top: calc(var(--header-total-height) + var(--space-8));
    padding-bottom: var(--space-20);
    background-color: var(--bg-white);
  }

  .patient-id__hero {
    display: grid;
    gap: var(--space-10);
  }

  .patient-id__intro {
    max-width: 760px;
  }

  .patient-id__title {
    font-size: clamp(2.9rem, 6vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
  }

  .patient-id__title-line {
    display: block;
  }

  .patient-id__title-line--top {
    white-space: nowrap;
  }

  .patient-id__title-highlight {
    color: var(--primary);
  }

  .patient-id__lead {
    font-size: var(--font-size-md);
    max-width: none;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .patient-id__media {
    position: relative;
  }

  .patient-id__media-frame {
    position: relative;
    aspect-ratio: 16 / 7;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: #b0bec5;
  }

  .patient-id__media-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .patient-id__cta {
    position: absolute;
    left: var(--space-10);
    bottom: var(--space-10);
    width: min(100%, 260px);
    background-color: #0a5f9c;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-lg);
    text-align: center;
  }

  .patient-id__cta p {
    color: var(--text-white);
    font-size: var(--font-size-lg);
    line-height: 1.15;
    margin-bottom: var(--space-4);
  }

  .patient-id__cta :global(.btn) {
    width: 100%;
    background-color: #084c7d;
    border-color: #084c7d;
  }

  .patient-id__stats {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-8);
    align-items: center;
    padding-top: var(--space-2);
  }

  .patient-id__stats-text {
    max-width: 58ch;
    margin-bottom: var(--space-6);
  }

  .patient-id__metrics {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: var(--space-4) var(--space-10);
  }

  .patient-id__metric strong {
    display: block;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1;
    color: var(--text-primary);
  }

  .patient-id__metric span {
    display: block;
    margin-top: var(--space-1);
    color: var(--text-secondary);
  }

  .patient-id__chart {
    display: grid;
    place-items: center;
    gap: var(--space-4);
  }

  .patient-id__donut {
    --outer-progress: 22%;
    width: min(100%, 230px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(
      #0b78b8 0 var(--outer-progress),
      #73c7d2 var(--outer-progress) 100%
    );
    position: relative;
    display: grid;
    place-items: center;
  }

  .patient-id__donut::before,
  .patient-id__donut::after {
    content: '';
    position: absolute;
    inset: 16%;
    border-radius: 50%;
    background: var(--bg-white);
  }

  .patient-id__donut::after {
    inset: 34%;
    box-shadow: inset 0 0 0 16px #73c7d2;
    background: var(--bg-white);
  }

  .patient-id__chart-value {
    position: relative;
    z-index: 2;
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    font-weight: var(--font-weight-bold);
    color: var(--primary);
  }

  .patient-id__chart-label {
    color: var(--text-primary);
    font-weight: var(--font-weight-medium);
  }

  .patient-id__benefits {
    margin-top: var(--space-16);
    padding: var(--space-16) 0;
    background-color: #ececec;
  }

  .patient-id__benefits-head {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: var(--space-10);
    align-items: start;
    margin-bottom: var(--space-10);
  }

  .patient-id__benefits-head h2 {
    font-size: var(--font-size-xl);
  }

  .patient-id__benefits-head p {
    color: var(--text-primary);
    max-width: 62ch;
  }

  .patient-id__benefit-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .patient-id__benefit-card {
    background-color: var(--bg-white);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-card);
  }

  .patient-id__icon {
    width: 112px;
    margin: 0 auto var(--space-5);
  }

  .patient-id__benefit-card h3 {
    font-size: var(--font-size-md);
    margin-bottom: var(--space-3);
  }

  .patient-id__benefits-ribbon {
    width: min(100%, 680px);
    margin: var(--space-10) auto 0;
    padding: var(--space-3) var(--space-8);
    border-radius: var(--radius-full);
    background-color: var(--primary);
    color: var(--text-white);
    text-align: center;
  }

  .patient-id__solutions {
    padding-top: var(--space-16);
  }

  .patient-id__solutions-layout {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: var(--space-10);
    align-items: start;
  }

  .patient-id__solutions-copy {
    align-self: center;
  }

  .patient-id__solutions-copy span {
    display: block;
    color: var(--primary);
    font-size: clamp(1.5rem, 4vw, 2rem);
    line-height: 1;
  }

  .patient-id__solutions-copy h2 {
    color: var(--primary);
    font-size: clamp(2.8rem, 6vw, 4rem);
    line-height: 0.9;
  }

  .patient-id__solutions-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }

  .patient-id__solution-card {
    display: grid;
    gap: var(--space-4);
  }

  .patient-id__solution-media {
    min-height: 260px;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #edf2f7, #d9e3ec);
    border: 1px dashed #b6c4d0;
    display: grid;
    place-items: center;
    color: var(--text-muted);
    font-weight: var(--font-weight-medium);
  }

  .patient-id__solution-body h3 {
    font-size: var(--font-size-md);
    margin-bottom: var(--space-2);
  }

  .patient-id__solution-body p {
    margin-bottom: var(--space-4);
  }

  .patient-id__solution-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 180px;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    border: 2px solid var(--primary);
    color: var(--primary);
    font-weight: var(--font-weight-semibold);
    transition: all var(--transition-fast);
  }

  .patient-id__solution-link:hover {
    background-color: var(--primary);
    color: var(--text-white);
  }

  @media (max-width: 1024px) {
    .patient-id__stats,
    .patient-id__benefits-head,
    .patient-id__solutions-layout,
    .patient-id__benefit-grid,
    .patient-id__solutions-grid {
      grid-template-columns: 1fr;
    }

    .patient-id__solutions-copy {
      align-self: start;
    }
  }

  @media (max-width: 768px) {
    .patient-id {
      padding-top: calc(var(--header-total-height) + var(--space-6));
    }

    .patient-id__lead {
      white-space: normal;
    }

    .patient-id__media-frame {
      aspect-ratio: 16 / 9;
    }

    .patient-id__cta {
      position: static;
      margin-top: var(--space-4);
      width: 100%;
    }

    .patient-id__metrics {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .patient-id__benefit-card,
    .patient-id__benefits-ribbon {
      padding-left: var(--space-5);
      padding-right: var(--space-5);
    }

    .patient-id__solution-media {
      min-height: 200px;
    }
  }
</style>
