---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'IDMedic — Soluciones de Identificación y Seguridad Médica',
  description = 'IDMedic: expertos en soluciones de identificación y seguridad para el sector salud. Brazaletes, impresoras, etiquetado médico y más para clínicas y hospitales.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0066B3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
