---
interface Props {
  title: string;
  description: string;
  href?: string;
  image?: string;
}

const { title, description, href = '#', image } = Astro.props;
---

<a href={href} class="area-card">
  <div class="area-card__bg" aria-hidden="true">
    {image && <img src={image} alt="" class="area-card__img" loading="lazy" />}
  </div>
  <div class="area-card__overlay"></div>
  <div class="area-card__content">
    <h3 class="area-card__title">{title}</h3>
    <p class="area-card__description">{description}</p>
    <span class="area-card__cta">Ver más</span>
  </div>
</a>

<style>
  .area-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    min-height: 270px;
    cursor: pointer;
    text-decoration: none;
    transition: transform var(--transition-base);
  }

  .area-card:hover {
    transform: scale(1.02);
  }

  .area-card:hover .area-card__overlay {
    opacity: 0.45;
  }

  .area-card:hover .area-card__img {
    transform: scale(1.05);
  }

  .area-card__bg {
    position: absolute;
    inset: 0;
    background-color: #b0b8c1;
  }

  .area-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .area-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 30, 60, 0.85) 0%,
      rgba(0, 30, 60, 0.4) 50%,
      rgba(0, 30, 60, 0.1) 100%
    );
    transition: opacity var(--transition-base);
    opacity: 1;
  }

  .area-card__content {
    position: relative;
    z-index: 2;
    padding: var(--space-6);
    color: var(--text-white);
    width: 100%;
  }

  .area-card__title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--text-white);
    margin-bottom: var(--space-1);
    line-height: var(--line-height-tight);
  }

  .area-card__description {
    font-size: var(--font-size-xs);
    color: rgba(255, 255, 255, 0.85);
    line-height: var(--line-height-normal);
    margin-bottom: var(--space-3);
    max-width: 280px;
  }

  .area-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--text-white);
    padding: 0.8rem 1.45rem;
    border: 1.5px solid rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    transition: all var(--transition-fast);
    background: transparent;
  }

  .area-card:hover .area-card__cta {
    background: #ffffff;
    border-color: #ffffff;
    color: rgba(10, 108, 183, 0.42);
  }
</style>
