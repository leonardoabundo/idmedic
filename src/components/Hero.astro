---

---

<section class="hero" id="hero">
  <div class="hero__background" aria-hidden="true">
    <div class="hero__gradient"></div>
  </div>
  <div class="hero__content container">
    <div class="hero__text">
      <span class="hero__badge">Soluciones para el sector salud</span>
      <h1 class="hero__title">
        Identificación y seguridad<br />
        <span class="hero__title-accent">para cada paciente</span>
      </h1>
      <p class="hero__subtitle">
        Tecnología avanzada en brazaletes, impresoras y etiquetado médico 
        para clínicas y hospitales de todo el Perú.
      </p>
      <div class="hero__actions">
        <a href="#productos" class="btn btn-white btn-lg">Conoce nuestras soluciones</a>
        <a href="#contacto" class="btn btn-outline-white btn-lg">Contáctanos</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(85vh, 640px);
    display: flex;
    align-items: center;
    margin-top: var(--header-total-height);
    overflow: hidden;
  }

  .hero__background {
    position: absolute;
    inset: 0;
    background-image: url('/images/inicio/PORTADA1scaled.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: #B0BEC5;
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(11, 42, 69, 0.92) 0%,
      rgba(0, 102, 179, 0.75) 45%,
      rgba(0, 102, 179, 0.3) 70%,
      transparent 100%
    );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .hero__text {
    max-width: 620px;
  }

  .hero__badge {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background-color: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: rgba(255, 255, 255, 0.95);
    margin-bottom: var(--space-6);
    letter-spacing: 0.02em;
  }

  .hero__title {
    font-size: var(--font-size-hero);
    font-weight: var(--font-weight-bold);
    color: var(--text-white);
    margin-bottom: var(--space-6);
    letter-spacing: -0.02em;
  }

  .hero__title-accent {
    color: rgba(255, 255, 255, 0.85);
    font-weight: var(--font-weight-semibold);
  }

  .hero__subtitle {
    font-size: var(--font-size-md);
    color: rgba(255, 255, 255, 0.8);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--space-10);
    max-width: 520px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (max-width: 768px) {
    .hero {
      min-height: min(75vh, 520px);
    }

    .hero__gradient {
      background: linear-gradient(
        180deg,
        rgba(11, 42, 69, 0.9) 0%,
        rgba(0, 102, 179, 0.7) 100%
      );
    }

    .hero__content {
      padding-top: var(--space-12);
      padding-bottom: var(--space-12);
    }

    .hero__actions {
      flex-direction: column;
    }

    .hero__actions .btn {
      text-align: center;
    }
  }
</style>
