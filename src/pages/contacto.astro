---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Contacto | IDMedic"
  description="Ponte en contacto con IDMedic para consultas comerciales, soporte o información de productos."
>
  <Header />
  <main class="contact-page">
    <div class="container">
      <section class="contact-page__hero">
        <span class="section-label">Contacto</span>
        <h1>Hablemos sobre tu necesidad</h1>
        <p>
          Si buscas brazaletes, etiquetas, impresoras o soluciones para bioseguridad,
          podemos orientarte según el tipo de institución, flujo operativo y requerimiento
          técnico.
        </p>
      </section>

      <section class="contact-page__grid">
        <article class="contact-page__card contact-page__card--info">
          <h2>Canales de atención</h2>
          <div class="contact-page__info-list">
            <div>
              <h3>Teléfono</h3>
              <p>940150106</p>
            </div>
            <div>
              <h3>Email</h3>
              <p>ventas@idmedic.com.pe</p>
            </div>
            <div>
              <h3>Ubicación</h3>
              <p>Magadalena del Mar, Lima Perú</p>
            </div>
          </div>
        </article>

        <article class="contact-page__card">
          <h2>Envíanos un mensaje</h2>
          <form class="contact-page__form">
            <label class="contact-page__field">
              <span>Nombre</span>
              <input type="text" name="name" placeholder="Tu nombre" />
            </label>

            <label class="contact-page__field">
              <span>Email</span>
              <input type="email" name="email" placeholder="Tu correo" />
            </label>

            <label class="contact-page__field">
              <span>Asunto</span>
              <input type="text" name="subject" placeholder="Motivo de contacto" />
            </label>

            <label class="contact-page__field">
              <span>Mensaje</span>
              <textarea name="message" rows="5" placeholder="Cuéntanos qué necesitas"></textarea>
            </label>

            <button type="submit" class="btn btn-primary btn-lg">Enviar consulta</button>
          </form>
        </article>
      </section>
    </div>
  </main>
  <Footer />
</MainLayout>

<style>
  .contact-page {
    padding-top: calc(var(--header-total-height) + var(--space-10));
    padding-bottom: var(--space-20);
    background:
      radial-gradient(circle at top left, rgba(0, 163, 224, 0.12), transparent 24%),
      linear-gradient(180deg, #f9fbfd 0%, #eef4f9 100%);
  }

  .contact-page__hero {
    max-width: 760px;
    margin-bottom: var(--space-10);
  }

  .contact-page__hero h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin-bottom: var(--space-4);
  }

  .contact-page__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--space-6);
  }

  .contact-page__card {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0.96);
    border: 1px solid #dfe8f0;
    box-shadow: 0 18px 44px rgba(11, 42, 69, 0.08);
  }

  .contact-page__card h2 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    margin-bottom: var(--space-5);
    letter-spacing: -0.03em;
  }

  .contact-page__info-list {
    display: grid;
    gap: var(--space-5);
  }

  .contact-page__info-list h3 {
    font-size: var(--font-size-sm);
    margin-bottom: var(--space-1);
    color: var(--primary);
  }

  .contact-page__info-list p {
    font-size: var(--font-size-base);
    color: var(--text-primary);
  }

  .contact-page__form {
    display: grid;
    gap: var(--space-4);
  }

  .contact-page__field {
    display: grid;
    gap: var(--space-2);
  }

  .contact-page__field span {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--text-primary);
  }

  .contact-page__field input,
  .contact-page__field textarea {
    width: 100%;
    min-height: 54px;
    padding: 0 16px;
    border: 1.5px solid #cfd8e3;
    border-radius: 14px;
    background-color: #ffffff;
    color: #111827;
    font-size: 1rem;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .contact-page__field textarea {
    min-height: 140px;
    padding-top: 14px;
    resize: vertical;
  }

  .contact-page__field input:focus,
  .contact-page__field textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(0, 102, 179, 0.12);
  }

  .contact-page__form :global(.btn) {
    justify-self: flex-start;
    margin-top: var(--space-2);
  }

  @media (max-width: 900px) {
    .contact-page__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
