---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'Áreas de atención', href: '/#areas' },
  { label: 'Productos', href: '/#productos' },
  { label: 'Blog', href: '/#blog' },
  { label: 'Nosotros', href: '/nosotros' },
];

const services = [
  { label: 'Identificación de pacientes', href: '/areas/identificacion-de-pacientes' },
  { label: 'Impresoras especializadas', href: '/areas/impresoras' },
  { label: 'Vestimenta para bioseguridad', href: '/areas/vestimenta-para-bioseguridad' },
  { label: 'Etiquetado médico', href: '/areas/etiquetado-medico' },
  { label: 'Software de gestión', href: '/areas/software' },
];
---

<footer class="footer" id="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo" aria-label="IDMedic - Inicio">
          <img src="/images/idmedic-logo-png.png" alt="IDMedic" class="footer__logo-img" />
        </a>
        <p class="footer__brand-text">
          Expertos en soluciones de identificación y seguridad médica para clínicas y hospitales de todo el Perú.
        </p>
      </div>

      <div class="footer__column">
        <h4 class="footer__column-title">Enlaces</h4>
        <ul class="footer__list">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="footer__link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__column">
        <h4 class="footer__column-title">Servicios</h4>
        <ul class="footer__list">
          {services.map((link) => (
            <li>
              <a href={link.href} class="footer__link">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__column">
        <h4 class="footer__column-title">Contacto</h4>
        <ul class="footer__list footer__contact">
          <li class="footer__contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" />
            </svg>
            <span>(01) 123-4567</span>
          </li>
          <li class="footer__contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
            <span>info@idmedic.com</span>
          </li>
          <li class="footer__contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>Magadalena del Mar, Lima Perú</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {currentYear} IDMedic. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--bg-dark);
    padding-top: var(--space-16);
    padding-bottom: 0;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: var(--space-10);
    padding-bottom: var(--space-12);
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    transition: opacity var(--transition-fast);
  }

  .footer__logo:hover {
    opacity: 0.8;
  }

  .footer__logo-img {
    height: 80px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
  }

  .footer__brand-text {
    font-size: var(--font-size-sm);
    color: var(--text-light);
    line-height: var(--line-height-relaxed);
    max-width: 280px;
  }

  .footer__column-title {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--text-white);
    margin-bottom: var(--space-5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__link {
    font-size: var(--font-size-sm);
    color: var(--text-light);
    transition: color var(--transition-fast);
  }

  .footer__link:hover {
    color: var(--text-white);
  }

  .footer__contact-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--text-light);
  }

  .footer__contact-item svg {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: var(--space-6) 0;
  }

  .footer__copyright {
    font-size: var(--font-size-xs);
    color: var(--text-muted);
    text-align: center;
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }
</style>
