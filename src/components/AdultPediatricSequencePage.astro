---
import type { ProductCategory, ProductSubcategory } from '../data/productCatalog';

interface Props {
  category: ProductCategory;
  subcategory: ProductSubcategory;
}

const { category, subcategory } = Astro.props;

const serviceHighlights = [
  {
    label: 'Pide en linea facil',
    icon: 'bag',
  },
  {
    label: 'Entrega rapida y confiable',
    icon: 'home',
  },
  {
    label: 'Apoyo y asesoramiento',
    icon: 'user',
  },
];

const sequenceFrames = Array.from(
  { length: 114 },
  (_, index) =>
    `/images/Categoria%20de%20producto/brazalete%20adulto/pulsera%20blanca/pulsera-blanca${String(index + 31).padStart(3, '0')}.png`
);
---

<section class="adult-seq">
  <div class="container">
    <div class="adult-seq__layout" data-adult-track>
      <div class="adult-seq__content">
        <header class="adult-seq__header">
          <nav class="adult-seq__breadcrumb-nav" aria-label="Ruta de navegacion">
            <a href="/">Inicio</a>
            <span>/</span>
            <a href={category.href}>{category.label}</a>
            <span>/</span>
            <span>{subcategory.label}</span>
          </nav>
        </header>

        <section class="adult-seq__hero">
          <article class="adult-seq__hero-copy">
            <h1>{subcategory.heroTitle}</h1>
            <p>{subcategory.heroDescription}</p>
            <strong>Conoce mas</strong>
            <p>{subcategory.infoDescription}</p>
            <a href="/#footer" class="adult-seq__link">Leer mas</a>
          </article>
        </section>

        <section class="adult-seq__highlights" aria-label="Ventajas del servicio">
          <div class="adult-seq__highlights-inner">
            {serviceHighlights.map((item) => (
              <article class="adult-seq__highlight">
                <span class="adult-seq__highlight-icon" aria-hidden="true">
                  {item.icon === 'bag' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 8h12l-1 11H7L6 8Z" />
                      <path d="M9 8a3 3 0 1 1 6 0" />
                    </svg>
                  )}
                  {item.icon === 'home' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m3 11 9-7 9 7" />
                      <path d="M5 10.5V20h14v-9.5" />
                    </svg>
                  )}
                  {item.icon === 'user' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="8" r="3.5" />
                      <path d="M5 20a7 7 0 0 1 14 0" />
                    </svg>
                  )}
                </span>
                <span>{item.label}</span>
              </article>
            ))}
          </div>
        </section>

        <section class="adult-seq__catalog">
          <h2>{subcategory.listingTitle}</h2>

          <div class="adult-seq__cards">
            {subcategory.featuredProducts.map((card) => (
              <article class="adult-seq__card">
                <div class="adult-seq__card-media" aria-label={`Espacio reservado para ${card.title}`}>
                  <span>Espacio para imagen</span>
                </div>
                <div class="adult-seq__card-body">
                  <h3>{card.title}</h3>
                  <p>{card.meta}</p>
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="adult-seq__info">
          <article class="adult-seq__info-box">
            <h2>{subcategory.infoTitle}</h2>
            <p>{subcategory.infoDescription}</p>
            <p>
              Esta secuencia visual acompana el contenido del producto y permite presentar mejor el brazalete mientras el usuario sigue bajando la pagina.
            </p>
          </article>
        </section>
      </div>

      <aside class="adult-seq__sequence-column">
        <div class="adult-seq__sequence" data-adult-sequence data-frames={JSON.stringify(sequenceFrames)}>
          <div class="adult-seq__sequence-frame">
            <canvas class="adult-seq__canvas" aria-label="Animacion de brazalete adulto por secuencia de imagenes"></canvas>
            <div class="adult-seq__fallback">Cargando secuencia del producto</div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  const sequenceRoot = document.querySelector('[data-adult-sequence]');

  if (sequenceRoot instanceof HTMLElement) {
    const trackRoot = sequenceRoot.closest('[data-adult-track]') || sequenceRoot;
    const frameElement = sequenceRoot.querySelector('.adult-seq__sequence-frame');
    const canvas = sequenceRoot.querySelector('canvas');
    const fallback = sequenceRoot.querySelector('.adult-seq__fallback');
    const frames = JSON.parse(sequenceRoot.dataset.frames || '[]');

    if (canvas instanceof HTMLCanvasElement && Array.isArray(frames) && frames.length > 0) {
      const context = canvas.getContext('2d', { alpha: true });
      const orderedFrames = new Array(frames.length);
      let readyCount = 0;
      let hasShownFirstFrame = false;

      const getPlayableFrames = () => orderedFrames.filter(Boolean);

      const setCanvasSize = (image) => {
        const bounds = canvas.getBoundingClientRect();
        const ratio = window.devicePixelRatio || 1;
        canvas.width = Math.max(1, Math.round(bounds.width * ratio));
        canvas.height = Math.max(1, Math.round(bounds.height * ratio));

        if (context) {
          context.setTransform(1, 0, 0, 1, 0, 0);
          context.scale(ratio, ratio);
        }

        if (image) drawFrame(image);
      };

      const drawFrame = (image) => {
        if (!context) return;

        const bounds = canvas.getBoundingClientRect();
        const width = bounds.width;
        const height = bounds.height;

        context.clearRect(0, 0, width, height);

        const baseScale = Math.min(width / image.naturalWidth, height / image.naturalHeight);
        const scale = baseScale * 1.08;
        const drawWidth = image.naturalWidth * scale;
        const drawHeight = image.naturalHeight * scale;
        const offsetX = (width - drawWidth) / 2;
        const offsetY = (height - drawHeight) / 2;

        context.drawImage(image, offsetX, offsetY, drawWidth, drawHeight);
      };

      const updateFrameFromScroll = () => {
        const playableFrames = getPlayableFrames();
        if (playableFrames.length === 0) return;

        const scrollTop = window.scrollY || window.pageYOffset || 0;
        const trackRect = trackRoot.getBoundingClientRect();
        const trackTop = trackRect.top + scrollTop;
        const stickyTop = frameElement instanceof HTMLElement
          ? parseFloat(window.getComputedStyle(frameElement).top || '0') || 0
          : 0;
        const stickyHeight = frameElement instanceof HTMLElement
          ? frameElement.offsetHeight || canvas.offsetHeight || 1
          : canvas.offsetHeight || 1;
        const trackHeight = trackRoot.scrollHeight || trackRoot.offsetHeight || stickyHeight;
        const startScroll = Math.max(0, trackTop);
        const endScroll = startScroll + Math.max(1, trackHeight - stickyHeight - stickyTop);

        if (scrollTop <= startScroll) {
          if (orderedFrames[0]) drawFrame(orderedFrames[0]);
          return;
        }

        const rawProgress = (scrollTop - startScroll) / Math.max(1, endScroll - startScroll);
        const progress = Math.max(0, Math.min(1, rawProgress));
        const frameIndex = Math.min(playableFrames.length - 1, Math.round(progress * (playableFrames.length - 1)));

        drawFrame(playableFrames[frameIndex]);
      };

      const handleFrameLoad = (index, image) => {
        orderedFrames[index] = image;
        readyCount += 1;

        if (!hasShownFirstFrame && index === 0) {
          hasShownFirstFrame = true;
          setCanvasSize(image);
          fallback?.classList.add('is-hidden');
        }

        if (readyCount === frames.length || (index === 0 && window.scrollY <= 0)) {
          updateFrameFromScroll();
        }
      };

      frames.forEach((src, index) => {
        const image = new Image();
        image.decoding = 'async';
        image.loading = 'eager';
        image.onload = () => handleFrameLoad(index, image);
        image.onerror = () => {
          readyCount += 1;
          if (readyCount === frames.length) {
            updateFrameFromScroll();
          }
        };
        image.src = src;
      });

      const syncToScroll = () => {
        if (getPlayableFrames().length > 0) {
          updateFrameFromScroll();
        }
      };

      window.addEventListener('resize', () => {
        const playableFrames = getPlayableFrames();
        if (playableFrames.length > 0) {
          setCanvasSize(playableFrames[0]);
          updateFrameFromScroll();
        }
      });

      window.addEventListener('scroll', syncToScroll, { passive: true });
    }
  }
</script>

<style>
  .adult-seq {
    --sequence-height: min(520px, calc(100vh - var(--header-height) - var(--space-8)));
    padding-top: calc(var(--header-total-height) + var(--space-8));
    padding-bottom: var(--space-20);
    background-color: var(--bg-white);
  }

  .adult-seq__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: var(--space-8);
    align-items: stretch;
  }

  .adult-seq__content {
    display: grid;
    gap: var(--space-8);
    align-self: start;
  }

  .adult-seq__breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.98rem;
    color: var(--text-secondary);
  }

  .adult-seq__breadcrumb-nav a {
    transition: color var(--transition-fast);
  }

  .adult-seq__breadcrumb-nav a:hover {
    color: var(--primary);
  }

  .adult-seq__hero-copy {
    padding: var(--space-8);
    border-radius: 22px;
    background: linear-gradient(180deg, #ffffff 0%, #f4f8fc 100%);
    border: 1px solid #e1e9f2;
  }

  .adult-seq__hero-copy h1 {
    font-size: clamp(1.9rem, 3.1vw, 2.6rem);
    margin-bottom: var(--space-4);
    color: var(--primary);
    letter-spacing: -0.03em;
  }

  .adult-seq__hero-copy p {
    color: var(--text-secondary);
  }

  .adult-seq__hero-copy strong {
    display: inline-block;
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
    color: var(--primary);
    font-size: var(--font-size-sm);
  }

  .adult-seq__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 118px;
    margin-top: var(--space-5);
    padding: 0.8rem 1.4rem;
    border-radius: var(--radius-full);
    border: 2px solid var(--primary);
    color: var(--primary);
    font-weight: var(--font-weight-semibold);
    transition: all var(--transition-fast);
  }

  .adult-seq__link:hover {
    background-color: var(--primary);
    color: var(--text-white);
  }

  .adult-seq__sequence-column {
    position: relative;
    align-self: stretch;
    min-height: 100%;
  }

  .adult-seq__sequence {
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
  }

  .adult-seq__sequence-frame {
    position: relative;
    height: var(--sequence-height);
    border-radius: var(--radius-xl);
    overflow: hidden;
    background-color: var(--bg-white);
  }

  .adult-seq__canvas {
    display: block;
    width: 100%;
    height: var(--sequence-height);
  }

  .adult-seq__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--text-muted);
    font-weight: var(--font-weight-semibold);
  }

  .adult-seq__fallback.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  .adult-seq__highlights {
    width: 100%;
    padding: var(--space-4) 0;
    background-color: #f3f3f4;
  }

  .adult-seq__highlights-inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    padding: 0 var(--space-6);
  }

  .adult-seq__highlight {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    color: var(--text-primary);
    text-align: center;
    font-size: var(--font-size-sm);
  }

  .adult-seq__highlight-icon {
    width: 18px;
    height: 18px;
    color: #353535;
    flex-shrink: 0;
  }

  .adult-seq__catalog h2,
  .adult-seq__info-box h2 {
    font-size: clamp(1.4rem, 2vw, 1.9rem);
    margin-bottom: var(--space-5);
  }

  .adult-seq__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .adult-seq__card {
    display: grid;
    gap: var(--space-3);
  }

  .adult-seq__card-media {
    min-height: 290px;
    border-radius: 22px;
    background: linear-gradient(135deg, rgba(232, 239, 246, 0.95), rgba(218, 227, 236, 0.96));
    border: 1px dashed #b6c4d0;
    display: grid;
    place-items: center;
    color: var(--text-muted);
    text-align: center;
    font-weight: var(--font-weight-medium);
  }

  .adult-seq__card-body {
    text-align: center;
  }

  .adult-seq__card-body h3 {
    font-size: 1.06rem;
    margin-bottom: var(--space-1);
  }

  .adult-seq__card-body p {
    font-size: var(--font-size-sm);
    color: #8d8d95;
  }

  .adult-seq__info-box {
    padding: var(--space-8);
    border-radius: 22px;
    background: linear-gradient(180deg, #ffffff 0%, #f4f8fc 100%);
    border: 1px solid #e1e9f2;
  }

  .adult-seq__info-box p + p {
    margin-top: var(--space-4);
  }

  @media (max-width: 1024px) {
    .adult-seq__layout,
    .adult-seq__cards,
    .adult-seq__highlights-inner {
      grid-template-columns: 1fr;
    }

    .adult-seq__sequence {
      position: static;
      top: auto;
    }
  }

  @media (max-width: 768px) {
    .adult-seq {
      --sequence-height: min(360px, calc(100vh - var(--header-height) - var(--space-6)));
      padding-top: calc(var(--header-total-height) + var(--space-6));
      padding-bottom: var(--space-12);
    }

    .adult-seq__hero-copy,
    .adult-seq__info-box {
      padding: var(--space-6);
    }

    .adult-seq__highlights-inner {
      padding: 0 var(--space-4);
    }

    .adult-seq__card-media,
    .adult-seq__sequence-frame,
    .adult-seq__canvas {
      min-height: 220px;
      height: var(--sequence-height);
    }
  }
</style>
