---
import AdultPediatricWristbandsPage from '../../../components/AdultPediatricWristbandsPage.astro';
import AdultPediatricSequencePage from '../../../components/AdultPediatricSequencePage.astro';
import AlertSpecialWristbandsPage from '../../../components/AlertSpecialWristbandsPage.astro';
import NeonatalWristbandsPage from '../../../components/NeonatalWristbandsPage.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import MainLayout from '../../../layouts/MainLayout.astro';
import {
  getProductCategory,
  getProductSubcategory,
  productCatalog,
} from '../../../data/productCatalog';

export function getStaticPaths() {
  return productCatalog.flatMap((category) =>
    category.subcategories.map((subcategory) => ({
      params: {
        category: category.slug,
        subcategory: subcategory.slug,
      },
      props: {
        category,
        subcategory,
      },
    }))
  );
}

const { category, subcategory } = Astro.props;
const resolvedCategory = getProductCategory(category.slug);
const resolvedSubcategory = getProductSubcategory(category.slug, subcategory.slug);
---

<MainLayout
  title={`${subcategory.label} | ${category.label} | IDMedic`}
  description={subcategory.shortDescription}
>
  <Header />
  <main>
    {resolvedCategory && resolvedSubcategory && (
      resolvedCategory.slug === 'brazaletes' && resolvedSubcategory.slug === 'adulto-pediatrico' ? (
        <AdultPediatricSequencePage category={resolvedCategory} subcategory={resolvedSubcategory} />
      ) : resolvedCategory.slug === 'brazaletes' && resolvedSubcategory.slug === 'recien-nacidos' ? (
        <NeonatalWristbandsPage category={resolvedCategory} subcategory={resolvedSubcategory} />
      ) : resolvedCategory.slug === 'brazaletes' && resolvedSubcategory.slug === 'alerta-especial' ? (
        <AlertSpecialWristbandsPage category={resolvedCategory} subcategory={resolvedSubcategory} />
      ) : (
        <AdultPediatricWristbandsPage category={resolvedCategory} subcategory={resolvedSubcategory} />
      )
    )}
  </main>
  <Footer />
</MainLayout>
